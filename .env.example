# ── Required (web + worker) ───────────────────────────────
# Neon: use the *pooled* connection string, with sslmode=require
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/careerflow?sslmode=require
# 32 random bytes, base64. Generate with: npm run keys
APP_ENCRYPTION_KEY=
APP_HASH_KEY=
# Only during key rotation:
# APP_ENCRYPTION_KEY_PREVIOUS=

# ── Web (Vercel) ──────────────────────────────────────────
APP_URL=https://your-app.vercel.app
# Becomes admin when signing up with this email
ADMIN_EMAIL=
# open | closed (closed = only SIGNUP_ALLOWLIST emails can register)
SIGNUP_MODE=closed
SIGNUP_ALLOWLIST=you@example.com
# Password-reset email (https://resend.com). Required in production.
RESEND_API_KEY=
MAIL_FROM=CareerFlow AI <no-reply@yourdomain.com>

# ── Private file storage (Cloudflare R2 or any S3) ────────
S3_BUCKET=careerflow-private
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# R2 encrypts at rest itself and rejects the SSE header:
S3_SSE=off

# ── AI (used from the matching release onward) ───────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ── Worker (Railway) ─────────────────────────────────────
WORKER_KIND=general
DB_POOL_MAX=5
LOG_LEVEL=info
